{
  "name": "arthur-brooks-minimal-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts MainVideo output/final_master.mp4",
    "typecheck": "tsc --noEmit",
    "project:list": "python scripts/project.py list",
    "project:init": "python scripts/project.py init",
    "project:save": "python scripts/project.py save",
    "project:load": "python scripts/project.py load"
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/media-utils": "4.0.242",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.242"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
